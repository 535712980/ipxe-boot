server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    autoindex off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    # iPXE 精简网络栈不做压缩
    gzip off;

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    location = /health.txt {
        default_type text/plain;
        return 200 "ok\n";
    }
}
